# Local MongoDB (e.g. the one started by docker compose, exposed on port 27018)
MONGODB_URI=mongodb://localhost:27018/individual_course
# For MongoDB Atlas, replace with your connection string, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/individual_course?retryWrites=true&w=majority
# Optional: database name, if the URI has no /<database> path
# MONGODB_DB=individual_course

PORT=3000

# Comma-separated list of frontend origins allowed by CORS (scheme + host, no path).
# If empty, only http://localhost:* and http://127.0.0.1:* are allowed.
# ALLOWED_ORIGIN=https://<your-github-username>.github.io
ALLOWED_ORIGIN=
